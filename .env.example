# Skopiuj do .env.local i uzupełnij wartości z Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=twoj-anon-key

# Opcjonalnie — operacje administracyjne po stronie serwera
# SUPABASE_SERVICE_ROLE_KEY=twoj-service-role-key

# Panel administratora (tylko serwer — bez prefiksu NEXT_PUBLIC_)
ADMIN_LOGIN=twoj-login
ADMIN_PASSWORD=twoje-bezpieczne-haslo
